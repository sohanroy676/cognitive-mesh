# Copy to .env (git-ignored) and edit. Never put real keys in this file.

# Required. One of: groq, ollama, catalog (catalog: see docs/model-catalog.example.toml)
COGMESH_PROVIDER=ollama

# Required only when COGMESH_PROVIDER=groq. Set in .env, never commit.
GROQ_API_KEY=
# Groq model (a preview model; may be retired) and its reasoning effort:
# none, default, low, medium, high, or empty to omit the field.
COGMESH_GROQ_MODEL=qwen/qwen3.8-27b
COGMESH_GROQ_REASONING_EFFORT=none
# Groq is a third-party server: set to true only if file contents may be sent to it.
# Required for COGMESH_PROVIDER=groq; ignored for ollama (local).
COGMESH_ALLOW_REMOTE_CONTENT=false

COGMESH_OLLAMA_BASE_URL=http://localhost:11434
COGMESH_OLLAMA_MODEL=llama3.2
# Seconds allowed for one model call (greater than 0, at most 600).
COGMESH_MODEL_TIMEOUT_S=30
COGMESH_LOG_LEVEL=INFO

# Model catalog (only with COGMESH_PROVIDER=catalog, or `--model ID` on run/task/plan).
# The catalog file holds no keys; an entry names the variable that does, e.g. GEMINI_API_KEY.
COGMESH_MODEL_CATALOG=
COGMESH_MODEL=
# Must be true for catalog entries whose data_use is may_train or unknown (prompts may be
# kept or used for training by the provider). Remote entries also need
# COGMESH_ALLOW_REMOTE_CONTENT=true.
COGMESH_ALLOW_TRAINING_USE=false

# Needed only by `change pr` (push a change branch and open a pull request). Set in .env, never
# commit. Use a fine-grained token limited to one repository: contents and pull requests write.
GITHUB_TOKEN=
