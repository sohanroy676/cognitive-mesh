{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./venv/**)",
      "Read(./.venv/**)",
      "Read(./**/__pycache__/**)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Read(./coverage/**)"
    ],
    "ask": [
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)"
    ]
  }
}
